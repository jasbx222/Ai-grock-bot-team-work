{
  "name": "cats-office-desktop",
  "productName": "Cats Office",
  "version": "0.2.0",
  "description": "Cats Office desktop app",
  "main": "main.js",
  "author": "Jassim Mohamed",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^33.2.0",
    "@electron/packager": "^18.3.6"
  },
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-packager . CatsOffice --platform=win32 --arch=x64 --out=../desktop-dist --overwrite --asar --ignore=^/node_modules --ignore=package-lock.json",
    "pack:linux": "electron-packager . CatsOffice --platform=linux --arch=x64 --out=../desktop-dist --overwrite --asar --ignore=^/node_modules --ignore=package-lock.json"
  }
}